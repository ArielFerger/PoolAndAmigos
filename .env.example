# Copiar a .env y completar. El archivo .env NO se versiona.

# --- Base de datos ---
POSTGRES_DB=poolamigos
POSTGRES_USER=poolamigos
POSTGRES_PASSWORD=cambiar_en_produccion

# --- Admin unico (se usa a partir de la fase de seguridad) ---
ADMIN_USERNAME=admin
# Hash BCrypt de la contrasena, nunca la contrasena en texto plano
ADMIN_PASSWORD_HASH=
# Clave para firmar los JWT (minimo 32 caracteres)
JWT_SECRET=

# --- Frontend ---
# La resuelve el navegador en el host, por eso es localhost y no el nombre del servicio
VITE_API_URL=http://localhost:8080
